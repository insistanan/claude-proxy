{
  "schemaVersion": 1,
  "id": "mod.random-range-llm",
  "version": "1.0.0",
  "name": "随机数区间分布（LLM 分析）",
  "description": "一次请求生成 300 个随机整数，先做确定性分桶，再由任务选择的分析模型解释偏差。",
  "probeFile": "probe-prompt.md",
  "rulesFile": "rules.json",
  "sampling": {
    "mode": "batch",
    "defaultSampleCount": 300,
    "maximumSamples": 500,
    "sampleIntervalMs": 0,
    "maxOutputTokens": 4096
  },
  "parser": {
    "type": "json",
    "minimum": 0,
    "maximum": 100
  },
  "aggregation": {
    "type": "histogram",
    "buckets": [
      { "id": "low", "minimum": 0, "maximum": 49.999999 },
      { "id": "high", "minimum": 50, "maximum": 100 }
    ]
  },
  "analysis": {
    "mode": "llm",
    "promptFile": "analysis-prompt.md",
    "methodFile": "method.md",
    "resultSchemaFile": "result-schema.json"
  }
}
