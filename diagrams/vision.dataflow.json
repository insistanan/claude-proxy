{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "视觉分流旁路",
    "locale": "zh-CN",
    "output": "vision.html",
    "quality_profile": "showcase",
    "viewBox": [1072, 620],
    "views": [
      {
        "id": "cache-hit",
        "label": "缓存命中",
        "focus": ["built", "prepare", "memory", "rewrite"],
        "note": "内存已有描述，直接改写成文本块。"
      },
      {
        "id": "cache-miss",
        "label": "缓存未命中",
        "focus": ["prepare", "memory", "persist", "vision_select", "vision_api", "rewrite"],
        "note": "持久缓存也没有，才走独立视觉渠道。"
      },
      {
        "id": "independence",
        "label": "视觉渠道独立",
        "focus": ["vision_select", "vision_api"],
        "note": "SelectVisionChannel 不受主请求渠道绑定。"
      }
    ]
  },
  "stages": [
    { "label": "构造后" },
    { "label": "分流入口" },
    { "label": "两级缓存" },
    { "label": "视觉分析" },
    { "label": "写回请求" }
  ],
  "nodes": [
    { "id": "built", "type": "backend", "label": "上游请求", "sublabel": "已构造", "stage": 0, "row": 0 },
    { "id": "prepare", "type": "backend", "label": "PrepareRequest", "sublabel": "就地改写入口", "stage": 1, "row": 0, "tag": "不可绕过" },
    { "id": "memory", "type": "database", "label": "内存缓存", "sublabel": "进程内", "stage": 2, "row": 0 },
    { "id": "persist", "type": "database", "label": "持久缓存", "sublabel": "会话 / kind / 模型", "stage": 2, "row": 1 },
    { "id": "vision_select", "type": "backend", "label": "视觉选渠", "sublabel": "SelectVisionChannel", "stage": 3, "row": 1 },
    { "id": "vision_api", "type": "external", "label": "视觉上游", "sublabel": "图片转描述", "stage": 4, "row": 1 },
    { "id": "rewrite", "type": "backend", "label": "改写为文本", "sublabel": "按目标协议替换", "stage": 4, "row": 0 }
  ],
  "flows": [
    { "from": "built", "to": "prepare", "label": "进入分流", "classification": "单渠道尝试内", "variant": "emphasis" },
    { "from": "prepare", "to": "memory", "label": "查内存", "classification": "先内存" },
    { "from": "memory", "to": "persist", "label": "未命中", "classification": "再持久" },
    { "from": "memory", "to": "rewrite", "label": "命中", "classification": "描述文本", "variant": "emphasis", "route": "top-channel" },
    { "from": "persist", "to": "vision_select", "label": "仍未命中", "classification": "需要分析", "variant": "emphasis" },
    { "from": "vision_select", "to": "vision_api", "label": "发图片", "classification": "独立渠道", "variant": "emphasis" },
    { "from": "vision_api", "to": "rewrite", "label": "分析描述", "classification": "写回缓存", "variant": "emphasis" }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "不可绕过",
      "items": [
        "必须走 prepareRequestForUpstream",
        "直接改构造结果会漏分流"
      ]
    },
    {
      "dot": "emerald",
      "title": "两级缓存",
      "items": [
        "内存没有再查持久缓存",
        "同图并发用 claim 去重"
      ]
    },
    {
      "dot": "violet",
      "title": "独立选渠",
      "items": [
        "视觉渠道不受主请求绑定",
        "实现在 scheduler/vision.go"
      ]
    }
  ]
}
