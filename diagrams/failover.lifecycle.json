{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "三级故障转移",
    "locale": "zh-CN",
    "output": "failover.html",
    "quality_profile": "showcase",
    "viewBox": [1080, 640],
    "views": [
      {
        "id": "happy",
        "label": "一次成功",
        "focus": ["enter", "trying", "classify", "done"],
        "note": "当前 key 和 BaseURL 一次打通即结束。"
      },
      {
        "id": "retry-loop",
        "label": "换候选再试",
        "focus": ["classify", "retry", "trying"],
        "note": "先换 key，再换 BaseURL，再换渠道，回到 SendRequest。"
      },
      {
        "id": "give-up",
        "label": "耗尽退出",
        "focus": ["classify", "exhausted"],
        "note": "没有剩余候选时进入失败终态。"
      }
    ]
  },
  "lanes": [
    { "id": "main", "label": "一次上游尝试" },
    { "id": "retry", "label": "可恢复重试" },
    { "id": "terminal", "label": "终态" }
  ],
  "states": [
    { "id": "enter", "type": "start", "label": "进入尝试", "sublabel": "已选渠道", "lane": "main", "col": 0, "step": "01" },
    { "id": "trying", "type": "active", "label": "SendRequest", "sublabel": "当前 key + URL", "lane": "main", "col": 1, "step": "02" },
    { "id": "classify", "type": "decision", "label": "错误分类", "sublabel": "ShouldRetryWithNextKey", "lane": "main", "col": 2, "step": "03" },
    { "id": "done", "type": "success", "label": "返回客户端", "sublabel": "记用量后结束", "lane": "main", "col": 3, "step": "04" },
    { "id": "retry", "type": "failure", "label": "换候选", "sublabel": "key / URL / 渠道", "lane": "retry", "col": 0, "tag": "可恢复" },
    { "id": "exhausted", "type": "failure", "label": "全部失败", "sublabel": "无剩余候选", "lane": "terminal", "col": 1, "tag": "终态" }
  ],
  "transitions": [
    { "id": "enter-try", "from": "enter", "to": "trying" },
    { "id": "try-classify", "from": "trying", "to": "classify", "route": "straight" },
    { "id": "ok-done", "from": "classify", "to": "done", "label": "成功", "variant": "emphasis", "route": "straight" },
    { "id": "to-retry", "from": "classify", "to": "retry", "label": "可转移", "variant": "security", "route": "drop" },
    { "id": "retry-back", "from": "retry", "to": "trying", "label": "再发一次", "variant": "emphasis" },
    { "id": "to-exhausted", "from": "classify", "to": "exhausted", "label": "无候选", "variant": "security", "labelDy": 38 }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "三级顺序",
      "items": [
        "先换 key，再换 BaseURL，最后才换渠道"
      ]
    },
    {
      "dot": "amber",
      "title": "熔断另算",
      "items": [
        "失败率超阈值会挂起约 15 分钟"
      ]
    },
    {
      "dot": "rose",
      "title": "代码",
      "items": [
        "TryWithModelMappingFailover / HandleMultiChannelFailover"
      ]
    }
  ]
}
