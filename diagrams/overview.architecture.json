  "cards": [
    {
      "dot": "cyan",
      "title": "它是什么",
      "items": [
        "客户端以为自己在直接调用 Claude / OpenAI / Gemini",
        "实际先打到本程序，由它选路、翻译、再转发",
        "管理面板和代理打成一个可执行文件"
      ]
    },
    {
      "dot": "emerald",
      "title": "一次请求",
      "items": [
        "先用 PROXY_ACCESS_KEY 验钥匙",
        "再选一条健康渠道，必要时做协议转换",
        "上游挂了就换 key、换地址、换渠道"
      ]
    },
    {
      "dot": "amber",
      "title": "人怎么管",
      "items": [
        "浏览器打开 Web 面板改渠道和密钥",
        "本地保存配置、会话、指标和拦截记录",
        "不需要再单独部署一套前端"
      ]
    }
