{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "渠道选择优先级",
    "locale": "zh-CN",
    "output": "channel-select.html",
    "quality_profile": "showcase",
    "viewBox": [1100, 560],
    "views": [
      {
        "id": "miss-path",
        "label": "逐级往下找",
        "focus": ["request", "filter", "bind", "score", "selected"],
        "note": "绑定期没中，才进入自适应和优先级打分。"
      },
      {
        "id": "early-bind",
        "label": "提前绑死",
        "focus": ["bind", "selected"],
        "note": "覆盖、促销或 Trace 亲和命中后直接选出。"
      },
      {
        "id": "conflict",
        "label": "覆盖冲突",
        "focus": ["bind", "conflict"],
        "note": "对话路由覆盖冲突返回 409，不降级猜渠道。"
      }
    ]
  },
  "lanes": [
    { "id": "flow", "label": "选择顺序" },
    { "id": "result", "label": "选中结果" },
    { "id": "exceptions", "label": "冲突退出", "variant": "exception" }
  ],
  "phases": [
    { "id": "admit", "label": "过滤", "fromCol": 0, "toCol": 1 },
    { "id": "bind-phase", "label": "绑定优先", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "score-phase", "label": "打分选中", "fromCol": 4, "toCol": 5, "variant": "dashed" }
  ],
  "mainPath": ["request", "filter", "bind", "score", "selected"],
  "nodes": [
    { "id": "request", "lane": "flow", "col": 0, "type": "backend", "label": "代理请求", "sublabel": "model + userID" },
    { "id": "filter", "lane": "flow", "col": 1, "type": "security", "label": "过滤熔断", "sublabel": "挂起渠道不参与" },
    { "id": "bind", "lane": "flow", "col": 3, "type": "security", "label": "绑定优先", "sublabel": "覆盖 / 促销 / 亲和", "tag": "先到先停" },
    { "id": "score", "lane": "flow", "col": 5, "type": "backend", "label": "自适应调度", "sublabel": "画像后按优先级" },
    { "id": "selected", "lane": "result", "col": 5, "type": "cloud", "label": "选中渠道", "sublabel": "再排 BaseURL" },
    { "id": "conflict", "lane": "exceptions", "col": 3, "type": "security", "label": "覆盖冲突", "sublabel": "返回 409" }
  ],
  "edges": [
    { "id": "to-filter", "from": "request", "to": "filter", "variant": "emphasis", "role": "main" },
    { "id": "to-bind", "from": "filter", "to": "bind", "role": "main" },
    { "id": "miss-score", "from": "bind", "to": "score", "label": "未命中", "role": "main" },
    { "id": "score-pick", "from": "score", "to": "selected", "label": "选出", "variant": "emphasis", "role": "main" },
    { "id": "bind-hit", "from": "bind", "to": "selected", "label": "命中", "variant": "dashed", "role": "branch" },
    { "id": "bind-conflict", "from": "bind", "to": "conflict", "label": "规则冲突", "variant": "security", "role": "error", "route": "drop", "labelDx": 48 }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "先绑后打分",
      "items": [
        "覆盖、促销、Trace 亲和任一命中就停",
        "都没有才走性能画像和优先级"
      ]
    },
    {
      "dot": "rose",
      "title": "不猜",
      "items": [
        "熔断渠道整步过滤",
        "覆盖冲突返回 409"
      ]
    },
    {
      "dot": "cyan",
      "title": "代码",
      "items": [
        "SelectChannel 在 selection.go",
        "多 BaseURL 另按 urlhealth 排序"
      ]
    }
  ]
}
